<!DOCTYPE html>
<html lang="en" class="auth-pending">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <title>Dashboard · Syntecxhub</title>
    <link rel="icon" href="/images/brand-mark.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/app.js" defer></script>
  </head>
  <body class="app-page" data-page="dashboard">
    <div class="app-shell">
      <header class="app-header">
        <a class="brand" href="/dashboard" aria-label="Syntecxhub dashboard">
          <img src="/images/brand-mark.svg" alt="" width="34" height="34" />
          <span>syntecx<span class="brand-accent">hub</span></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a class="nav-link active" href="/dashboard">Overview</a>
          <a class="nav-link" href="/profile">My profile</a>
        </nav>
        <button class="button button-quiet button-small" type="button" data-logout>Sign out <span aria-hidden="true">↗</span></button>
      </header>

      <main class="dashboard-main">
        <div class="page-heading">
          <div>
            <span class="eyebrow"><span class="eyebrow-dot"></span> ACCOUNT OVERVIEW</span>
            <h1>Welcome back<span class="heading-period">.</span></h1>
            <p class="page-subtitle">Your account at a glance.</p>
          </div>
          <a class="button button-secondary" href="/profile"><span aria-hidden="true">✎</span> Manage profile</a>
        </div>

        <div class="dashboard-grid">
          <section class="welcome-card">
            <div class="welcome-decoration" aria-hidden="true"></div>
            <span class="card-overline">YOUR WORKSPACE</span>
            <h2>Hello, <span id="welcome-name" class="skeleton-text">there</span></h2>
            <p>Your profile and account information are ready whenever you need them.</p>
            <a class="text-link" href="/profile">View your profile <span aria-hidden="true">→</span></a>
          </section>

          <section class="info-card" aria-labelledby="account-card-title">
            <div class="section-title-row">
              <div>
                <span class="card-overline">ACCOUNT DETAILS</span>
                <h2 id="account-card-title">Your information</h2>
              </div>
              <span class="icon-tile" aria-hidden="true">◎</span>
            </div>
            <div class="detail-list">
              <div class="detail-item">
                <span class="detail-label">Full name</span>
                <span class="detail-value" id="dashboard-full-name">Loading profile…</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Email address</span>
                <span class="detail-value" id="dashboard-email">Loading profile…</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Member since</span>
                <span class="detail-value" id="dashboard-created">Loading profile…</span>
              </div>
            </div>
            <div class="inline-message" data-dashboard-message role="status" aria-live="polite" hidden></div>
          </section>
        </div>

        <section class="bottom-callout">
          <div class="callout-icon" aria-hidden="true">✦</div>
          <div>
            <h2>Keep your profile up to date</h2>
            <p>Your name and email help keep your account information current.</p>
          </div>
          <a class="text-link" href="/profile">Edit details <span aria-hidden="true">→</span></a>
        </section>
      </main>

      <footer class="app-footer">
        <span>© <span data-current-year></span> Syntecxhub</span>
        <span>Account overview</span>
      </footer>
    </div>
  </body>
</html>
