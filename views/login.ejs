<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <title>Sign in · Syntecxhub</title>
    <link rel="icon" href="/images/brand-mark.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/app.js" defer></script>
  </head>
  <body class="auth-page" data-page="login">
    <div class="page-glow page-glow-one" aria-hidden="true"></div>
    <div class="page-glow page-glow-two" aria-hidden="true"></div>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/login" aria-label="Syntecxhub home">
          <img src="/images/brand-mark.svg" alt="" width="34" height="34" />
          <span>syntecx<span class="brand-accent">hub</span></span>
        </a>
        <p class="header-prompt">New here? <a href="/register">Create account</a></p>
      </header>

      <main class="auth-layout">
        <section class="auth-intro">
          <span class="eyebrow"><span class="eyebrow-dot"></span> WELCOME BACK</span>
          <h1>Your space.<br /><span>Your way.</span></h1>
          <p class="intro-copy">
            Sign in to pick up where you left off and manage your account securely.
          </p>
          <div class="intro-note">
            <span class="note-icon" aria-hidden="true">↗</span>
            <span><strong>Good to see you</strong><br />Your account is just a sign in away.</span>
          </div>
        </section>

        <section class="form-card login-card" aria-labelledby="form-title">
          <div class="form-card-top">
            <span class="form-kicker">YOUR WORKSPACE</span>
            <span class="secure-mark"><span aria-hidden="true">●</span> Private &amp; secure</span>
          </div>
          <h2 id="form-title">Welcome back</h2>
          <p class="form-subtitle">Enter your details to sign in to your account.</p>

          <div class="form-message" data-message role="alert" aria-live="polite" hidden></div>

          <form id="login-form" class="stacked-form" novalidate>
            <label class="field" for="email">
              <span>Email address</span>
              <input id="email" name="email" type="email" autocomplete="username" inputmode="email" placeholder="you@example.com" required />
            </label>
            <label class="field" for="password">
              <span>Password</span>
              <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Your password" required />
            </label>
            <button class="button button-primary button-wide" type="submit" data-submit-button>
              <span data-button-label>Sign in</span>
              <span class="button-spinner" aria-hidden="true" hidden></span>
              <span class="button-arrow" aria-hidden="true">→</span>
            </button>
          </form>

          <p class="form-footnote">Your sign-in is protected with secure token authentication.</p>
        </section>
      </main>

      <footer class="site-footer">
        <span>© <span data-current-year></span> Syntecxhub</span>
        <span class="footer-status"><span class="status-dot"></span> Account services</span>
      </footer>
    </div>
  </body>
</html>
